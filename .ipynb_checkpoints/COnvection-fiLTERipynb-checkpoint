    "'''import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import os\n",
    "import imageio.v2 as imageio\n",
    "\n",
    "# === Inputs ===\n",
    "dt = 1e-2\n",
    "save_folder = \"u_term_frames\"\n",
    "make_gif = True\n",
    "\n",
    "# Create output folder\n",
    "os.makedirs(save_folder, exist_ok=True)\n",
    "\n",
    "# Transpose u and w to (t, x, y[, ...])\n",
    "u_plot = np.transpose(u, (2, 0, 1, 3))  # from (Nx, Ny, Nt, 2) -> (Nt, Nx, Ny, 2)\n",
    "w_plot = np.transpose(w_lin, (2, 0, 1))     # from (Nx, Ny, Nt) -> (Nt, Nx, Ny)\n",
    "n_iter = u_plot.shape[0]\n",
    "#print(u_plot.shape)\n",
    "# === 1. Time derivative du/dt ===\n",
    "du_dt = np.zeros_like(u_plot)\n",
    "du_dt[1:-1] = (u_plot[2:] - u_plot[:-2]) / (2 * dt)\n",
    "du_dt[0] = (u_plot[1] - u_plot[0]) / dt\n",
    "du_dt[-1] = (u_plot[-1] - u_plot[-2]) / dt\n",
    "\n",
    "# === 2. Convective term u_beta * ∂_beta u_alpha ===\n",
    "def compute_convective_term(u_t):\n",
    "    uy, ux = np.gradient(u_t[..., 0], axis=(0, 1))  # ∂y u_x, ∂x u_x\n",
    "    vy, vx = np.gradient(u_t[..., 1], axis=(0, 1))  # ∂y u_y, ∂x u_y\n",
    "\n",
    "    u_x = u_t[..., 0]\n",
    "    u_y = u_t[..., 1]\n",
    "\n",
    "    adv_x = u_x * ux + u_y * uy\n",
    "    adv_y = u_x * vx + u_y * vy\n",
    "\n",
    "    return np.stack([adv_x, adv_y], axis=-1)\n",
    "\n",
    "u_adv = np.array([compute_convective_term(u_t) for u_t in u_plot])\n",
    "\n",
    "# === 3. Plot frames ===\n",
    "filenames = []\n",
    "\n",
    "for i in range(n_iter):\n",
    "    fig, axs = plt.subplots(1, 3, figsize=(15, 4))\n",
    "    \n",
    "    # Compute norms\n",
    "    #print(i)\n",
    "    norm_dt = np.linalg.norm(du_dt[i], axis=-1)\n",
    "    norm_adv = np.linalg.norm(u_adv[i], axis=-1)\n",
    "    w_i = w_plot[i]\n",
    "\n",
    "    # Plot ∂t u\n",
    "    im0 = axs[0].imshow(norm_dt.T, cmap='viridis', origin='lower')\n",
    "    axs[0].set_title(rf\"$\\partial_t u$ at $t = {i * dt:.2f}$\")\n",
    "    plt.colorbar(im0, ax=axs[0], fraction=0.046, pad=0.04)\n",
    "    \n",
    "    # Plot uβ ∂β uα\n",
    "    im1 = axs[1].imshow(norm_adv.T, cmap='plasma', origin='lower')\n",
    "    axs[1].set_title(r\"$u_\\beta \\partial_\\beta u_\\alpha$\")\n",
    "    plt.colorbar(im1, ax=axs[1], fraction=0.046, pad=0.04)\n",
    "    \n",
    "    # Plot scalar field w\n",
    "    im2 = axs[2].imshow(w_i.T, cmap='coolwarm', origin='lower')\n",
    "    axs[2].set_title(r\"$w$ scalar field\")\n",
    "    plt.colorbar(im2, ax=axs[2], fraction=0.046, pad=0.04)\n",
    "\n",
    "    for ax in axs:\n",
    "        ax.axis('off')\n",
    "\n",
    "    filename = os.path.join(save_folder, f\"frame_{i:03d}.png\")\n",
    "    filenames.append(filename)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(filename)\n",
    "    plt.close()\n",
    "\n",
    "# === 4. Optional GIF ===\n",
    "if make_gif:\n",
    "    gif_path = os.path.join(save_folder, \"u_terms_with_w.gif\")\n",
    "    with imageio.get_writer(gif_path, mode='I', duration=0.05) as writer:\n",
    "        for filename in filenames:\n",
    "            image = imageio.imread(filename)\n",
    "            writer.append_data(image)\n",
    "    print(f\"GIF saved to {gif_path}\")\n",
    "else:\n",
    "    print(f\"{n_iter} frames saved to '{save_folder}'\")'''"
